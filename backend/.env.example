# Mongo 地址只包含协议、主机和端口；Atlas 使用 mongodb+srv://YOUR_CLUSTER.mongodb.net。
MONGODB_SERVER=mongodb://localhost:27017
MONGODB_USERNAME=
# 填原始密码，无需 URL 编码；代码会自动转义。
MONGODB_PASSWORD=
MONGODB_APP_NAME=linghang-main-app
# 本地 replica set；Atlas 通常使用 {"retryWrites":true,"w":"majority"}。
MONGODB_OPTIONS={"replicaSet":"rs0","directConnection":true}
# 数据库命名空间；每次启动会重建该命名空间下的代次数据库。
MONGODB_DATABASE=linghang_main_app
# Generate your own: openssl rand -hex 32
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_SESSION_TTL_SECONDS=3600
CORS_ORIGINS=["http://localhost:5173"]
# Source stays authoritative: startup exports business data read-only, Auth stays here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Direct/session-pooler PostgreSQL connection with read access to business/auth/storage metadata + sequences.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require
# Optional for private avatar downloads; never expose in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Optional Auth0 ID-token exchange, following linghang-appt's flow.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
