# PRIVATE: copy values into app/.env or a separate ignored .env.migration.
# Supabase direct/session-pooler PostgreSQL connection, not the public HTTPS API URL.
# The account must read public business tables, necessary auth.users columns,
# storage.objects metadata, and identity sequences.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional for private Storage downloads. Public avatars need no server key.
SUPABASE_SERVICE_ROLE_KEY=
# Reuse app/.env MONGODB_URI or supply a separate target URI.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
