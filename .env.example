# These values are safe to expose in a browser. Never use a secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Optional local FastAPI origin. Used only with ?backend=mongo; when empty, that opt-in uses the isolated sandbox API.
# Ordinary visits keep using Supabase regardless of this value.
VITE_API_BASE_URL=
